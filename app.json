{
  "expo": {
    "name": "pmp-smart",
    "slug": "pmp-smart",
    "scheme": "pmpsmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pmpsmart.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a PMP Smart acceder a tu cámara para capturar fotos de las hojas de tus cultivos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a PMP Smart acceder a tus fotos para analizar hojas de papa guardadas en tu galería."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "14ac062a-e2f4-4d96-8681-0c005a1b14d7"
      }
    },
    "owner": "josecampo1"
  }
}

# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# URL del backend (opcional: la app funciona con almacenamiento local)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Clave de Google Gemini para el diagnóstico con IA
EXPO_PUBLIC_GEMINI_API_KEY=

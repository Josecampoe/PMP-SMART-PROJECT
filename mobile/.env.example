# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# URL del proxy de la IA (backend/ en Cloudflare Workers). Es pública: la clave de
# Gemini vive solo en el servidor y la app nunca la tiene.
EXPO_PUBLIC_API_URL=http://localhost:8787
